# ── Ethereum (Sepolia) ──────────────────────────────────────────────────────

# WebSocket RPC endpoint (Alchemy / Infura / your own node)
ETH_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# HTTP RPC endpoint (used for building receipt proofs)
ETH_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of the relayer wallet on Ethereum
# This key must be in the BeefyLightClient validator set
ETH_RELAYER_PRIVATE_KEY=0x...

# Deployed contract addresses on Sepolia
BEEFY_LIGHT_CLIENT_ADDRESS=0x...
POLKADEX_BRIDGE_ADDRESS=0x...

# Current BEEFY validator set ID (must match BeefyLightClient on-chain state)
BEEFY_VALIDATOR_SET_ID=1

# ── Polkadex ───────────────────────────────────────────────────────────────

# WebSocket RPC endpoint of your Polkadex node
POLKADEX_WS_URL=ws://127.0.0.1:9944

# Polkadex relayer account — SS58 seed phrase or hex seed
# This account must be set as AuthorizedRelayer in pallet-eth-bridge
POLKADEX_RELAYER_SEED=//Alice

# ── Relayer behaviour ──────────────────────────────────────────────────────

# How many Ethereum blocks to wait before processing a deposit (finality buffer)
ETH_CONFIRMATION_BLOCKS=12

# How often to poll Polkadex for new PendingWithdrawals (milliseconds)
WITHDRAWAL_POLL_INTERVAL_MS=12000

# Minimum number of pending withdrawals to batch before submitting to Ethereum
# Set to 1 for instant relaying (higher gas cost per withdrawal)
WITHDRAWAL_BATCH_SIZE=1

# Log level: debug | info | warn | error
LOG_LEVEL=info
