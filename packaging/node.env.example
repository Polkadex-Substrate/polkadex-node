# /etc/polkadex/node.env
# Copy this file to /etc/polkadex/node.env and edit before starting the service.
# Lines beginning with # are comments.

# Human-readable name shown on Polkadot telemetry (https://telemetry.polkadot.io)
NODE_NAME="My Polkadex Node"

# Extra flags passed verbatim to polkadex-node.
#
# ── Validator node ─────────────────────────────────────────────────────────────
#   EXTRA_FLAGS="--validator"
#
# ── Archive / RPC node ────────────────────────────────────────────────────────
#   EXTRA_FLAGS="--state-pruning=archive --blocks-pruning=archive --rpc-cors=all --rpc-external --unsafe-rpc-external --rpc-methods=safe --rpc-max-connections=1000 --rpc-max-response-size=500 --db-cache=4096"
#
# ── Flags already set by the service (do NOT repeat these) ───────────────────
#   --chain, --base-path, --database=rocksdb
#   --port=30333, --rpc-port=9944
#   --no-mdns, --sync=warp
#   --enable-offchain-indexing=true  ← required for MMR gadget / Hyperbridge
#   --bootnodes (both official Polkadex bootnodes)
#   --db-cache=2048
#   --prometheus-external, --prometheus-port=9615
#   --telemetry-url
#
EXTRA_FLAGS="--validator"
