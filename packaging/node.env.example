# /etc/polkadex/node.env
# Copy this file to /etc/polkadex/node.env and edit before starting the service.
# Lines beginning with # are comments.

# Human-readable name shown on Polkadot telemetry (https://telemetry.polkadot.io)
NODE_NAME="My Polkadex Node"

# Extra flags passed verbatim to polkadex-node.
#
# ── Validator node (most operators) ───────────────────────────────────────────
#   EXTRA_FLAGS="--validator"
#
# ── Full / archive node (e.g. RPC endpoint) ───────────────────────────────────
#   EXTRA_FLAGS="--pruning=archive --rpc-cors=all --rpc-external --rpc-methods=safe"
#
# ── Notes ─────────────────────────────────────────────────────────────────────
#   --enable-offchain-indexing=true is already set in the service file.
#   It is required for the MMR gadget (BEEFY finality proofs / Hyperbridge).
#   Do NOT remove it.
#
#   --pruning=archive is implied by --validator. Only set it explicitly
#   on non-validator nodes that need full history.
#
EXTRA_FLAGS="--validator"
