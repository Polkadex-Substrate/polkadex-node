# /etc/polkadex/node.env
# Copy this file to /etc/polkadex/node.env and edit before starting the service.
# Lines beginning with # are comments.

# Human-readable name shown on Polkadot telemetry
NODE_NAME="My Polkadex Node"

# Extra flags passed verbatim to polkadex-node.
# Example — validator node:
#   EXTRA_FLAGS="--validator"
# Example — full/archive node:
#   EXTRA_FLAGS="--pruning=archive --rpc-cors=all"
EXTRA_FLAGS=""
