# /etc/polkadex/node.env
# Copy this file to /etc/polkadex/node.env and edit before starting the service.
# Lines beginning with # are comments.

# Human-readable name shown on Polkadot telemetry (https://telemetry.polkadot.io)
NODE_NAME="My Polkadex Node"

# Set to "--validator" to run as a validator (author blocks, needs session
# keys set — see docs/run-a-validator.md). Leave empty for a full/RPC node.
# Empty by default: a freshly installed package should sync as a plain full
# node until the operator deliberately opts in to validating.
VALIDATOR_FLAG=""

# Anything else, passed verbatim to polkadex-node. Example for an archive/RPC
# node that serves external requests:
#   EXTRA_FLAGS="--state-pruning=archive --blocks-pruning=archive --rpc-cors=all --rpc-external --unsafe-rpc-external --rpc-methods=safe --rpc-max-connections=1000 --rpc-max-response-size=500"
EXTRA_FLAGS=""

# ── Flags already set by the service unit (do NOT repeat these here) ─────────
# Full explanation of every flag lives in packaging/deb/polkadex-node.service.
# Quick reference:
#   --chain, --base-path, --database=rocksdb   chain spec / data dir / DB engine
#   --port=30333, --rpc-port=9944               p2p and RPC ports
#   --rpc-methods=unsafe                         required for author_rotateKeys /
#                                                 author_insertKey over RPC — the
#                                                 documented session-key setup flow
#                                                 (docs/run-a-validator.md). RPC
#                                                 defaults to localhost-only unless
#                                                 --rpc-external is also passed, so
#                                                 this is not exposed by default.
#                                                 Kept intentionally: flipping it
#                                                 later means every validator has
#                                                 to reconfigure and restart again.
#   --no-mdns, --sync=warp                       no LAN discovery; fast initial sync
#   --enable-offchain-indexing=true              required for the MMR gadget used
#                                                 by BEEFY (bridging/light-client
#                                                 proofs) — unrelated to Hyperbridge,
#                                                 which is dormant on this runtime
#   --bootnodes                                  official Polkadex bootnode
#   --db-cache=4096                              RocksDB cache size, MB
#   --prometheus-port=9615                       metrics; binds to 127.0.0.1 only
#                                                 (no --prometheus-external, so it's
#                                                 not reachable off the host)
#   --telemetry-url                              reports to telemetry.polkadot.io
