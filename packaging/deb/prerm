#!/bin/sh
# prerm — runs before the package files are removed
set -e

# Stop the service if it's running
if command -v systemctl > /dev/null 2>&1 && systemctl is-active --quiet polkadex-node; then
    systemctl stop polkadex-node || true
fi

# Disable the service on full removal (not upgrade)
if [ "$1" = "remove" ]; then
    systemctl disable polkadex-node 2>/dev/null || true
fi
