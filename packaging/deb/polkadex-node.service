# systemd service unit for the Polkadex node
# Installed to: /lib/systemd/system/polkadex-node.service  (deb)
#               /usr/lib/systemd/system/polkadex-node.service (rpm)
#
# Post-install configuration:
#   1. Edit /etc/polkadex/node.env and set NODE_NAME, EXTRA_FLAGS etc.
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable --now polkadex-node
#
# Logs: journalctl -u polkadex-node -f

[Unit]
Description=Polkadex Node
Documentation=https://github.com/Polkadex-Substrate/polkadex-node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polkadex
Group=polkadex

# Load operator-supplied env vars (NODE_NAME, EXTRA_FLAGS, …)
EnvironmentFile=-/etc/polkadex/node.env

ExecStart=/usr/local/bin/polkadex-node \
    --chain=/etc/polkadex/customSpecRaw.json \
    --base-path=/var/lib/polkadex \
    --database=rocksdb \
    --name="${NODE_NAME:-polkadex-node}" \
    --port=30333 \
    --rpc-port=9944 \
    --rpc-methods=unsafe \
    --no-mdns \
    --sync=warp \
    --enable-offchain-indexing=true \
    --bootnodes=/dns/boot.polkadex.ee/tcp/30333/p2p/12D3KooWPBimEphuSb48WuwEm44WoACtgnRnDPiGf8ekhurWyc95 \
    --db-cache=2048 \
    --telemetry-url="wss://telemetry.polkadot.io/submit/ 0" \
    $EXTRA_FLAGS

Restart=on-failure
RestartSec=10s

# Give the node time to flush the RocksDB WAL on shutdown
TimeoutStopSec=120s

# Resource limits
LimitNOFILE=65536
LimitNPROC=8192

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/polkadex
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
